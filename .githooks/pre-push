#!/usr/bin/env bash
# Blocks the push unless the local CI checks pass.
# Skips the Gradle run when every update in this push deletes a remote ref.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
has_commit=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    has_commit=1
  fi
done

if [ "$has_commit" -eq 0 ]; then
  exit 0
fi

exec "$repo_root/.github/scripts/run_ci.sh"
